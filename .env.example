# Copy this file to .env and fill in real values. Never commit .env.

# Long random string — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The app binds to 127.0.0.1 only by default — keep it that way and put
# nginx/Caddy in front for HTTPS. Do not change HOST to 0.0.0.0 unless you
# fully understand the exposure and have a firewall rule to match.
HOST=127.0.0.1
PORT=3000

# Set to "production" only once you have real HTTPS running (via your reverse
# proxy) — this makes session cookies HTTPS-only. If you test over plain HTTP
# with this set to "production", logins will silently fail: the server will
# accept the correct gate answer/admin password but the browser will never
# actually stay logged in, and every attempt will look like a wrong answer
# with no error explaining why. Use "development" for local/plain-HTTP testing.
NODE_ENV=development

# Max size for a single photo/video submission, in megabytes. Bump this (and
# your nginx client_max_body_size, see README) if phone videos are getting rejected.
MAX_UPLOAD_MB=75
